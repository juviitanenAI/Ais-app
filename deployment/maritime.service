[Unit]
Description=Maritime FastAPI Service
After=network.target

[Service]
User=your_user
Group=www-data
WorkingDirectory=/home/your_user/publicwsgi/ais-app
EnvironmentFile=/home/your_user/publicwsgi/ais-app/.env
Environment="PATH=/home/your_user/publicwsgi/ais-app/.venv/bin"

# Note: Adjust uvicorn module path `main:app` and port if needed
ExecStart=/home/your_user/publicwsgi/ais-app/.venv/bin/uvicorn main:app --host ${APP_HOST} --port ${APP_PORT}

TimeoutStopSec=10
Restart=always
RestartSec=3

MemoryMax=512M
MemoryHigh=400M

[Install]
WantedBy=multi-user.target
